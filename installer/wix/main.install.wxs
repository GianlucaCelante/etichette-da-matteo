<?xml version="1.0" encoding="utf-8"?>
<!--
    Sostituzione del main.wxs generato da jpackage, usata solo quando
    Build-Setup.ps1 passa l'opzione "resource-dir" a jpackage (comportamento
    predefinito di questo installer). Ridotta da
    agent-java/scripts/installer/wix/main.auto-install.wxs: qui c'e' un solo
    servizio, un solo ambiente, nessuna pagina di registrazione da aprire,
    nessun downgrade/rollback da supportare (un cliente solo: se un
    aggiornamento fallisce ci pensa update.ps1 a rimettere in piedi il
    servizio sulla versione ancora sul disco, vedi installer\update.ps1).

    Cosa fa in piu' rispetto all'MSI generico di jpackage:
      - Azione differita elevata EtichetteInstallService: dopo aver copiato i
        file e creato le scorciatoie di jpackage, esegue
        "app\install_service.ps1 -Silent" (crea la cartella dati, apre la
        porta nel firewall, registra/avvia il servizio, crea le scorciatoie
        desktop + avvio automatico verso Edge in modalita' app). E' cosi'
        che un doppio clic sull'MSI installa tutto.
      - Azione differita EtichetteUninstallService, SOLO su disinstallazione
        vera (non durante un aggiornamento "installa sopra"): ferma e
        deregistra il servizio prima che i file vengano rimossi.
      - Componente ServiceControl di sicurezza: ferma nativamente il
        servizio prima che InstallFiles sovrascriva i binari, come rete di
        sicurezza per un'installazione silenziosa (/qn) che non sia passata
        da installer\update.ps1 (che ferma gia' il servizio da se').

    Le variabili JpXxx e le stringhe !(loc.Xxx) vengono da jpackage stesso
    (generate in JpConfigDir/overrides.wxi e nei file di risorse di default
    del JDK): non servono file .wxl propri, esattamente come nel riferimento
    di agent-java.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <?ifdef JpIsSystemWide ?>
    <?define JpInstallScope="perMachine"?>
  <?else?>
    <?define JpInstallScope="perUser"?>
  <?endif?>

  <?define JpProductLanguage=1033 ?>
  <?define JpInstallerVersion=200 ?>
  <?define JpCompressedMsi=yes ?>
  <?define JpAllowUpgrades=yes ?>
  <!--
      Niente JpAllowDowngrades: installare un MSI piu' vecchio sopra uno piu'
      nuovo resta bloccato, comportamento di default di jpackage. Con un
      cliente solo non serve un vero rollback via MSI: se un aggiornamento
      fallisce, update.ps1 rimette in piedi il servizio sulla versione ancora
      presente sul disco (msiexec non arriva a sostituire i file se fallisce
      prima, e Windows Installer li ripristina se fallisce durante).
  -->

  <?include $(var.JpConfigDir)/overrides.wxi ?>

  <?ifdef JpAllowUpgrades ?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="no"?>
    <?define JpUpgradeVersionIncludeMaximum="yes"?>
  <?else?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="yes"?>
    <?define JpUpgradeVersionIncludeMaximum="yes"?>
  <?endif?>
  <?define JpUpgradeVersionOnlyDetectDowngrade="yes"?>
  <?define JpUpgradeVersionIncludeMinimum="no"?>

  <Product
    Id="*"
    Name="$(var.JpAppName)"
    Language="$(var.JpProductLanguage)"
    Version="$(var.JpAppVersion)"
    Manufacturer="$(var.JpAppVendor)"
    UpgradeCode="$(var.JpProductUpgradeCode)">

    <Package
      Description="$(var.JpAppDescription)"
      Manufacturer="$(var.JpAppVendor)"
      InstallerVersion="$(var.JpInstallerVersion)"
      Compressed="$(var.JpCompressedMsi)"
      InstallScope="$(var.JpInstallScope)" Platform="x64"
    />

    <Media Id="1" Cabinet="Data.cab" EmbedCab="yes" />

    <Upgrade Id="$(var.JpProductUpgradeCode)">
      <UpgradeVersion
        OnlyDetect="$(var.JpUpgradeVersionOnlyDetectUpgrade)"
        Property="JP_UPGRADABLE_FOUND"
        Maximum="$(var.JpAppVersion)"
        MigrateFeatures="yes"
        IncludeMaximum="$(var.JpUpgradeVersionIncludeMaximum)" />
      <UpgradeVersion
        OnlyDetect="$(var.JpUpgradeVersionOnlyDetectDowngrade)"
        Property="JP_DOWNGRADABLE_FOUND"
        Minimum="$(var.JpAppVersion)"
        MigrateFeatures="yes"
        IncludeMinimum="$(var.JpUpgradeVersionIncludeMinimum)" />
    </Upgrade>

    <?ifndef JpAllowUpgrades ?>
    <CustomAction Id="JpDisallowUpgrade" Error="!(loc.DisallowUpgradeErrorMessage)" />
    <?endif?>
    <CustomAction Id="JpDisallowDowngrade" Error="!(loc.DowngradeErrorMessage)" />

    <!-- Radice obbligatoria -->
    <Directory Id="TARGETDIR" Name="SourceDir"/>

    <Feature Id="DefaultFeature" Title="!(loc.MainFeatureTitle)" Level="1">
      <ComponentGroupRef Id="Shortcuts"/>
      <ComponentGroupRef Id="Files"/>
      <ComponentGroupRef Id="FileAssociations"/>
      <ComponentRef Id="EtichetteServiceControl"/>
    </Feature>

    <CustomAction Id="JpSetARPINSTALLLOCATION" Property="ARPINSTALLLOCATION" Value="[INSTALLDIR]" />
    <CustomAction Id="JpSetARPCOMMENTS" Property="ARPCOMMENTS" Value="$(var.JpAppDescription)" />
    <CustomAction Id="JpSetARPCONTACT" Property="ARPCONTACT" Value="$(var.JpAppVendor)" />
    <CustomAction Id="JpSetARPSIZE" Property="ARPSIZE" Value="$(var.JpAppSizeKb)" />

    <?ifdef JpIcon ?>
    <Property Id="ARPPRODUCTICON" Value="JpARPPRODUCTICON"/>
    <Icon Id="JpARPPRODUCTICON" SourceFile="$(var.JpIcon)"/>
    <?endif?>

    <!--
        Installazione/avvio del servizio: azione differita ed elevata (gira
        come SYSTEM, non impersona l'utente), eseguita subito dopo che
        jpackage ha creato le scorciatoie standard. Passa sempre -Silent:
        un'azione differita MSI non gira nella sessione interattiva
        dell'utente, quindi non potrebbe aprire un browser in modo
        affidabile. Le scorciatoie verso l'app (desktop + avvio automatico)
        le crea install_service.ps1 stesso.

        Condizione "(NOT Installed AND NOT REMOVE) OR REINSTALL": fa partire
        l'azione per un'installazione nuova e per un aggiornamento
        "installa sopra" (REINSTALL viene impostato quando UpgradeCode +
        ProductCode coincidono con un prodotto gia' installato), mai per una
        disinstallazione.
    -->
    <CustomAction
      Id="EtichetteInstallService"
      Directory="TARGETDIR"
      ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLDIR]app\install_service.ps1&quot; -Silent"
      Execute="deferred"
      Return="check"
      Impersonate="no" />

    <!--
        Deregistrazione completa SOLO su disinstallazione vera
        (REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE). Windows Installer
        imposta UPGRADINGPRODUCTCODE mentre esegue la disinstallazione
        annidata del prodotto precedente per conto di RemoveExistingProducts
        durante un aggiornamento: se in quel momento deregistrassimo il
        servizio (winsw uninstall = DeleteService) mentre
        EtichetteInstallService lo ricrea subito dopo nella STESSA
        transazione, la SCM lo segna "marked for delete" (errore Win32 1072)
        e l'intera installazione va in rollback. Una disinstallazione vera
        (Programmi e funzionalita' o msiexec /x) non ha
        UPGRADINGPRODUCTCODE impostato, quindi qui deregistra per davvero.
    -->
    <SetProperty
      Id="EtichetteUninstallService"
      Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLDIR]app\uninstall_service.ps1&quot;"
      Before="EtichetteUninstallService"
      Sequence="execute">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</SetProperty>
    <CustomAction
      Id="EtichetteUninstallService"
      BinaryKey="WixCA"
      DllEntry="WixSilentExec64"
      Execute="deferred"
      Return="ignore"
      Impersonate="no" />

    <!--
        Rete di sicurezza: ferma il servizio nativamente (azione standard
        StopServices, elevata, dopo InstallValidate e prima di InstallFiles)
        cosi' un'installazione silenziosa (/qn) lanciata SENZA passare da
        installer\update.ps1 non trova i binari occupati. update.ps1 ferma
        gia' il servizio da solo prima di lanciare msiexec (e' quello che
        evita il prompt di riavvio su un doppio clic manuale); questo e'
        solo il ripiego.
        Ne' @Remove ne' @Start: la deregistrazione resta a
        EtichetteUninstallService, l'avvio resta a EtichetteInstallService.
        Ancorato a INSTALLDIR con una chiave di registro come KeyPath (non un
        file), cosi' l'identita' del componente non dipende da nessun file
        generato da jpackage.
    -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="EtichetteServiceControl" Guid="A2783679-0312-4FFD-9ED9-25DE8EA336E5" Win64="yes">
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Etichette\Installer"
                       Name="ServiceControlAnchor"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <ServiceControl Id="StopEtichetteSvc"
                        Name="Etichette"
                        Stop="both"
                        Wait="yes" />
      </Component>
    </DirectoryRef>

    <UIRef Id="JpUI"/>

    <InstallExecuteSequence>
      <Custom Action="JpSetARPINSTALLLOCATION" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPCOMMENTS" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPCONTACT" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPSIZE" After="CostFinalize">Not Installed</Custom>

      <?ifndef JpAllowUpgrades ?>
      <Custom Action="JpDisallowUpgrade" After="FindRelatedProducts">JP_UPGRADABLE_FOUND</Custom>
      <?endif?>
      <Custom Action="JpDisallowDowngrade" After="FindRelatedProducts">JP_DOWNGRADABLE_FOUND</Custom>

      <Custom Action="EtichetteUninstallService" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="EtichetteInstallService" After="CreateShortcuts">(NOT Installed AND NOT REMOVE) OR REINSTALL</Custom>

      <RemoveExistingProducts After="InstallInitialize"/>
    </InstallExecuteSequence>

  </Product>
</Wix>
